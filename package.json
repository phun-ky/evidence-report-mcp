  "description": "",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test --enable-source-maps 'src/**/__tests__/**/*.spec.ts'",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "node --import tsx --test --enable-source-maps --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-exclude='src/test/**' --test-coverage-lines=94 --test-coverage-branches=94 --test-coverage-functions=97 'src/**/__tests__/**/*.spec.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "eslint": "10.15.0",
    "eslint-config-phun-ky": "3.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module",
  "bin": {
    "verify-mcp": "dist/cli.js"
  }
