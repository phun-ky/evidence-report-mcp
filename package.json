{
  "name": "evidence-report-mcp",
  "version": "0.2.0",
  "description": "An MCP server with one verify tool: agents call it before acting on data they did not produce, and get an evidence report back, not a yes or no.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "verification",
    "evidence",
    "osv",
    "json-schema",
    "c2pa",
    "provenance",
    "agents"
  ],
  "homepage": "https://github.com/phun-ky/evidence-report-mcp#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/evidence-report-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/evidence-report-mcp.git"
  },
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "evidence-report-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/test",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test --enable-source-maps 'src/**/__tests__/**/*.spec.ts'",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "node --import tsx --test --enable-source-maps --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-exclude='src/test/**' --test-coverage-lines=96 --test-coverage-branches=100 --test-coverage-functions=100 'src/**/__tests__/**/*.spec.ts'",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:hooks": "node --test scripts/__tests__/commit-msg.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "docs:gen": "typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors",
    "predocs:dev": "npm run docs:gen",
    "docs:dev": "vitepress dev docs",
    "predocs:build": "npm run docs:gen",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "render:logo": "node scripts/render-logo.mjs",
    "release": "release-it",
    "release:dry-run": ".github/scripts/should-release.sh && release-it --ci --dry-run --github.release=false --no-git.requireCleanWorkingDir --no-git.requireUpstream"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@fontsource/work-sans": "5.3.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-phun-ky": "3.0.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "release-it": "21.1.2",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "6.0.3",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.5"
    }
  }
}
